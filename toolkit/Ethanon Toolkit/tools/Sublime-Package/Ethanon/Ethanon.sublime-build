{
	// ethanon_build (ethanon_build.py) finds the folder holding main.angelscript above the current file,
	// runs the command there and appends "dir=<that folder>"; output coloured by Ethanon Build Output.sublime-syntax.
	"target": "ethanon_build",
	"cancel": {"kill": true},
	"syntax": "scope:text.ethanon-build",
	"selector": "source.ethanon, source.enml",

	"cmd": ["machine", "-nowait"],
	"file_regex": "^\\[(?:ERROR|WARN) ?\\] (.+?), line ([0-9]+):([0-9]+)? (.*)$",

	"windows":
	{
		"cmd": ["machine.exe", "-nowait", "-norun"],
		"file_regex": "^\\[(?:ERROR|WARN) ?\\] (.+?), line ([0-9]+):([0-9]+)? (.*)$",
		"encoding": "cp850"
	},

	"osx":
	{
		"cmd":["/Applications/machine.app/Contents/MacOS/machine", "-nowait", "-norun"],
		"file_regex": "^\\[(?:ERROR|WARN) ?\\] (.+?), line ([0-9]+):([0-9]+)? (.*)$"
	},

	"variants":
	[
		{
			"name": "Run",
			"windows":
			{
				"shell_cmd": "start cmd /c \"machine.exe -nowait -testing & pause\""
			},
			"osx":
			{
				"cmd": ["/Applications/machine.app/Contents/MacOS/machine", "-nowait", "-testing"]
			}
		}
	]
}
